# 14) Aumentamos un 10% el precio de los productos de "perifericos"

from decimal import Decimal

with Session(engine) as session:

    productos = session.query(Producto) \
                       .filter(Producto.categoria == "perifericos") \
                       .all()

    for producto in productos:
        producto.precio = producto.precio * Decimal("1.10")

    # Un solo commit al final
    session.commit()

    print("----------------------------------------")
    print("14)")
    
    # Verificamos los precios
    for producto in productos:
        print("Nombre del producto:", producto.nombre)
        print("Nuevo precio(10%):", producto.precio)
        print("----------------------------------------")

# El teclado después del aumento cuesta 9350.00

