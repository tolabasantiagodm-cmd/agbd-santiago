from sqlalchemy import Column, Integer, String, Boolean, Numeric, create_engine, desc, or_
from sqlalchemy.orm import DeclarativeBase, Session


# Definimos la clase Base
class Base(DeclarativeBase):
    pass

# ----------------------------------------------------------------
# ----------------------------------------------------------------

# 1) Definimos el modelo Producto
class Producto(Base):
    __tablename__ = "productos"

    id = Column(Integer, primary_key=True, autoincrement=True) 
    nombre = Column(String)
    categoria = Column(String)
    precio = Column(Numeric(10, 2))
    stock = Column(Integer)
    activo = Column(Boolean, default=True)


# Creamos el engine utilizando SQLite
engine = create_engine("sqlite:///mi_app.db")


# Creamos las tablas en la base de datos
Base.metadata.create_all(engine)

print("----------------------------------------")
print("1) Tabla productos creada correctamente:")
print("----------------------------------------")

