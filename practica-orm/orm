        print("----------------------------------------")


# ----------------------------------------------------------------
# ----------------------------------------------------------------

# 4) Traemos los productos cuyo precio mayor a $10000 y de mayor e menor(precio)
with Session(engine) as session:
    productos = session.query(Producto) \
                       .filter(Producto.precio > 10000) \
                       .order_by(desc(Producto.precio)) \
                       .all()

    for producto in productos:
        print("----------------------------------------")
        print("4) Prodctos mayor 100000 y de mayor a menor:", producto.nombre, producto.precio)
        print("----------------------------------------")

# ----------------------------------------------------------------
# ----------------------------------------------------------------

# 5) Trameos los productos con stock menor o igual a 12 (activos)

with Session(engine) as session:
    productos = session.query(Producto) \
                       .filter(Producto.stock <= 12) \
                       .filter(Producto.activo == True) \
                       .all()

    for producto in productos:
        print("----------------------------------------")
        print("5) Productos con stock menor o igual a 12 (activos):", producto.nombre, producto.stock)
        print("----------------------------------------")

# Porque la consulta tiene dos condiciones y el Hub USB-C solo cumple una.

