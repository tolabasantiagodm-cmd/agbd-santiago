    producto = session.query(Producto) \
                       .filter(Producto.id == 9) \
                       .first()
    
    print("----------------------------------------")
    print("13) Nombre del producto:", producto.nombre)
    print("Stock:", producto.stock)
    print("Activo:", producto.activo)
    print("----------------------------------------")

