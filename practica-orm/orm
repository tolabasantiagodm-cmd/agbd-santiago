# 16) Eliminamos productos que tengan precio menor a 2000 o inactivos

with Session(engine) as session:

    productos = session.query(Producto) \
                       .filter(
                           or_(
                               Producto.precio < 2000,
                               Producto.activo == False
                           )
                       ) \
                       .all()

    cantidad_borrados = len(productos)

    for producto in productos:
        print("Eliminando:", producto.nombre)
        session.delete(producto)

    session.commit()

    print("----------------------------------------")
    print("16) Productos eliminados:", cantidad_borrados)
    print("----------------------------------------")


