# 13) Buscamos el Hub USB-C por id y actualizamos sus datos

with Session(engine) as session:

    # Buscamos el producto por su id
    producto = session.get(Producto, 9)

    # Actualizamos stock y activo
    producto.stock = 20
    producto.activo = True

    # Guardamos los cambios
    session.commit()


# Verificamos que los cambios se guardaron
